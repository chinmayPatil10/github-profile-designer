{
  "name": "github-profile-designer-mcp",
  "version": "0.1.0",
  "description": "MCP server that designs and publishes GitHub profile READMEs in 8 styles",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "examples": "tsx scripts/examples.ts"
  },
  "keywords": [
    "mcp",
    "github",
    "profile",
    "readme",
    "model-context-protocol"
  ],
  "author": "Chinmay Patil",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "github-profile-designer-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chinmayPatil10/github-profile-designer-mcp"
  }
}
